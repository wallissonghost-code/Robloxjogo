{
  "name": "MundialWar",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "MundialWarShared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "MundialWar": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "MundialWar": {
          "$path": "src/client"
        }
      }
    },
    "Players": {
      "$className": "Players",
      "$properties": {
        "CharacterAutoLoads": false
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "StreamingEnabled": false
      }
    }
  }
}
